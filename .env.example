# python3 scripts/configure.py generates both values in a private .env file.
RADAR_PASSWORD=
POSTGRES_PASSWORD=
RADAR_PORT=3000
# Set true when the browser uses HTTPS.
RADAR_SECURE_COOKIE=false
RADAR_NOTICES_PER_SOURCE=5
# Native execution defaults to runtime/radar.sqlite3. Compose configures PostgreSQL.
# DATABASE_URL=postgresql+psycopg://...
# SMTP_MODE supports ssl (465) or starttls (587). All mail is optional.
SMTP_HOST=
SMTP_PORT=465
SMTP_MODE=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
